*.jpeg
*.jpg
*.pdf

# ---- Python ----
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

